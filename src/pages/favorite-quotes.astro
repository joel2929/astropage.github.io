---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const quotes = [
  {
    text: 'In the mind of the beginner there are many possibilities, in the mind of the expert there are few.',
    author: 'Shunryu Suzuki',
  },
  {
    text: 'If you ever want to back an opponent down, you need to make him/her believe that you have a weapon that he/she cannot match.',
    author: 'Charl Sonne · Law of Power 101',
    note: 'Attribution as noted; source not verified.',
  },
  {
    text: 'To know your enemy, you must become your enemy.',
    author: 'Sun Tzu',
  },
  {
    text: 'If you hang around the barbershop long enough, sooner or later you’re going to get a haircut.',
    author: 'Denzel Washington',
    note: 'A reminder about persistence, opportunity, and the influence of your surroundings.',
  },
  {
    text: 'Control what you can control, don’t try to control what you can’t control.',
    author: 'Personal reminder',
  },
  {
    text: 'Power resides where men believe it resides.',
    author: 'Varys · Game of Thrones',
  },
  {
    text: 'The more you judge, the more you’re going to separate yourself from others. You’ll feel good for an instant because you’ll feel good about yourself, thinking, “I’m better than that.” But then you’ll feel lonely. And then, you’re just going to see negativity everywhere. The world just reflects your own feelings back at you.',
    author: 'Naval Ravikant',
    note: 'Paraphrased from The Joe Rogan Experience, episode 1309.',
  },
  {
    text: 'A man who fears suffering is already suffering from what he fears.',
    author: 'Michel de Montaigne · Essays, III.13',
  },
  {
    text: 'You do not experience life, you experience the life you focus on and the meaning you give it.',
    author: 'Naval Ravikant',
  },
];
---

<BaseLayout
  title="Favorite quotes — Joel Marte"
  description="Favorite quotes and reminders collected by Joel Marte."
>
  <div class="quotes-page-shell">
    <header class="quotes-topbar">
      <a class="wordmark" href={`${base}#top`} aria-label="Joel Marte home"><span class="mark">jm</span><span>Joel Marte</span></a>
      <nav aria-label="Page navigation">
        <a href={`${base}#work`}>All projects</a>
        <a class="nav-contact" href="mailto:hello@joelmarte.com">Say hello <span>↗</span></a>
        <button class="theme-toggle" data-theme-toggle type="button" aria-pressed="false" aria-label="Switch to light mode" title="Switch to light mode"><span data-theme-icon aria-hidden="true">☼</span></button>
      </nav>
    </header>

    <main class="quotes-article">
      <a class="quotes-back mono" href={`${base}#work`}>← &nbsp;Back to projects</a>
      <header class="quotes-heading">
        <p class="mono quotes-kicker"><span class="dot"></span> Notes to keep <span class="slash">/</span> Quotes</p>
        <h1 class="serif">Words worth<br /><em>remembering.</em></h1>
      </header>

      <section class="quotes-list" aria-label="Favorite quotes">
        {quotes.map((quote, index) => (
          <figure class="quote-entry">
            <p class="mono quote-number">{String(index + 1).padStart(2, '0')}</p>
            <blockquote>{quote.text}</blockquote>
            <figcaption>
              <span class="quote-author">{quote.author}</span>
              {quote.note && <span class="quote-note">{quote.note}</span>}
            </figcaption>
          </figure>
        ))}
      </section>
    </main>

    <footer class="quotes-footer"><a href={`${base}#work`}>← Back to the home page</a><span class="mono">Joel Marte · © {new Date().getFullYear()}</span></footer>
  </div>
</BaseLayout>

<style>
  .quotes-page-shell{max-width:1440px;margin:auto;padding:0 7.2%}.quotes-topbar{height:88px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.wordmark{display:flex;gap:11px;align-items:center;text-decoration:none;font-weight:700;font-size:.9rem;letter-spacing:-.03em}.mark{display:grid;place-items:center;width:29px;height:29px;background:var(--acid);border-radius:50%;font-family:'Playfair Display',serif;font-size:.9rem;font-style:italic}.quotes-topbar nav{display:flex;align-items:center;gap:28px;font-size:.8rem}.quotes-topbar nav a{text-decoration:none;color:var(--nav-link)}.quotes-topbar .nav-contact{padding:11px 15px;border:1px solid var(--ink);border-radius:99px;color:var(--ink)}.nav-contact span{margin-left:12px}.theme-toggle{width:39px;height:39px;display:grid;place-items:center;padding:0;border:1px solid var(--line);border-radius:50%;background:transparent;color:var(--ink);font:500 1.15rem 'DM Sans',sans-serif;cursor:pointer;transition:background-color .2s,border-color .2s,transform .2s}.theme-toggle:hover{background:var(--line);transform:rotate(-10deg)}
  .quotes-article{max-width:920px;margin:0 auto;padding:55px 0 82px}.quotes-back{display:inline-block;color:var(--muted);text-decoration:none;margin-bottom:58px}.quotes-heading{max-width:760px;margin-bottom:56px}.quotes-kicker{display:flex;align-items:center;gap:10px;color:var(--muted)}.quotes-kicker .dot{width:7px;height:7px;background:var(--dot);border-radius:50%;box-shadow:0 0 0 4px var(--dot-shadow)}.quotes-kicker .slash{color:var(--slash)}.quotes-heading h1{font-size:clamp(3.5rem,8vw,6.6rem);line-height:.98;letter-spacing:-.06em;font-weight:500;margin:25px 0 22px}.quotes-heading h1 em{color:var(--accent);font-weight:500}.quotes-lede{max-width:620px;color:var(--body-copy);font-size:1.05rem;line-height:1.8;margin:0}.quotes-list{border-top:1px solid var(--line)}.quote-entry{position:relative;margin:0;padding:34px 0 38px 58px;border-bottom:1px solid var(--line)}.quote-number{position:absolute;left:0;top:40px;color:var(--number)}.quote-entry blockquote{margin:0;color:var(--ink);font:500 clamp(1.25rem,2.5vw,1.75rem)/1.55 'Playfair Display',Georgia,serif;letter-spacing:-.015em}.quote-entry figcaption{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin-top:18px}.quote-author{color:var(--accent);font-size:.8rem;font-weight:600}.quote-note{color:var(--muted);font:400 .66rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.06em}.quotes-footer{min-height:92px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:20px;color:var(--muted);font-size:.76rem}.quotes-footer a{color:var(--nav-link);text-decoration:none}
  @media(max-width:760px){.quotes-page-shell{padding:0 6%}.quotes-topbar{height:72px}.quotes-topbar nav{gap:15px}.quotes-topbar nav a{font-size:.72rem}.quotes-topbar .nav-contact{padding:9px 11px}.nav-contact span{margin-left:5px}.theme-toggle{width:35px;height:35px}.quotes-article{padding:40px 0 60px}.quotes-back{margin-bottom:43px}.quotes-heading{margin-bottom:40px}.quote-entry{padding:29px 0 32px 39px}.quote-number{top:34px}.quotes-footer{padding:20px 0;align-items:flex-start;flex-direction:column;justify-content:center}}
  @media(max-width:390px){.quotes-topbar nav{gap:10px}.quotes-topbar nav a:first-child{display:none}.quotes-topbar .wordmark{font-size:.82rem}.theme-toggle{width:32px;height:32px}.quote-entry{padding-left:33px}}
</style>
