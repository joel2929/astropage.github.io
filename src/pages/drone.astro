---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const photos = [
  { file: 'Birtds-Eye-ViewThumbnail.webp', label: 'Bird’s-eye view', alt: 'A drone view looking straight down at a wooded backyard and patio' },
  { file: 'GoingUpThumbnail.webp', label: 'Going up', alt: 'A drone view over rooftops and trees at the edge of town' },
  { file: 'ComingBack.webp', label: 'Coming back', alt: 'A drone view looking down through a canopy of green trees' },
];
---

<BaseLayout
  title="Drone flights — Joel Marte"
  description="A collection of photos from Joel Marte’s drone flights."
>
  <div class="drone-page-shell">
    <header class="drone-topbar">
      <a class="wordmark" href={`${base}#top`} aria-label="Joel Marte home"><span class="mark">jm</span><span>Joel Marte</span></a>
      <nav aria-label="Page navigation">
        <a href={`${base}#work`}>All projects</a>
        <a class="nav-contact" href="mailto:hello@joelmarte.com">Say hello <span>↗</span></a>
        <button class="theme-toggle" data-theme-toggle type="button" aria-pressed="false" aria-label="Switch to light mode" title="Switch to light mode"><span data-theme-icon aria-hidden="true">☼</span></button>
      </nav>
    </header>

    <main class="drone-article">
      <a class="drone-back mono" href={`${base}#work`}>← &nbsp;Back to projects</a>
      <header class="drone-heading">
        <p class="mono drone-kicker"><span class="dot"></span> Hobbies <span class="slash">/</span> Drone flights</p>
        <h1 class="serif">A different point of view.</h1>
        <p class="drone-lede">A few moments from learning to fly and seeing familiar places from above.</p>
      </header>

      <figure class="drone-feature">

        <figcaption class="mono">A bird’s-eye view</figcaption>
      </figure>

      <section class="drone-gallery" aria-labelledby="gallery-title">
        <div class="drone-section-heading">
          <p class="mono">01 &nbsp; / &nbsp; In the air</p>
          <h2 id="gallery-title" class="serif">Looking around.</h2>
          <p>More views from the flights, from heading up to finding the way back.</p>
        </div>
        <div class="drone-photo-list">
          {photos.map((photo) => (
            <figure class="drone-photo">
            
              <figcaption class="mono">{photo.label}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    </main>

    <footer class="drone-footer"><a href={`${base}#work`}>← Back to the home page</a><span class="mono">Joel Marte · © {new Date().getFullYear()}</span></footer>
  </div>
</BaseLayout>

<style>
  .drone-page-shell{max-width:1440px;margin:auto;padding:0 7.2%}.drone-topbar{height:88px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.wordmark{display:flex;gap:11px;align-items:center;text-decoration:none;font-weight:700;font-size:.9rem;letter-spacing:-.03em}.mark{display:grid;place-items:center;width:29px;height:29px;background:var(--acid);border-radius:50%;font-family:'Playfair Display',serif;font-size:.9rem;font-style:italic}.drone-topbar nav{display:flex;align-items:center;gap:28px;font-size:.8rem}.drone-topbar nav a{text-decoration:none;color:var(--nav-link)}.drone-topbar .nav-contact{padding:11px 15px;border:1px solid var(--ink);border-radius:99px;color:var(--ink)}.nav-contact span{margin-left:12px}.theme-toggle{width:39px;height:39px;display:grid;place-items:center;padding:0;border:1px solid var(--line);border-radius:50%;background:transparent;color:var(--ink);font:500 1.15rem 'DM Sans',sans-serif;cursor:pointer;transition:background-color .2s,border-color .2s,transform .2s}.theme-toggle:hover{background:var(--line);transform:rotate(-10deg)}
  
  @media(max-width:760px){.drone-page-shell{padding:0 6%}.drone-topbar{height:72px}.drone-topbar nav{gap:15px}.drone-topbar nav a{font-size:.72rem}.drone-topbar .nav-contact{padding:9px 11px}.nav-contact span{margin-left:5px}.theme-toggle{width:35px;height:35px}.drone-article{padding:40px 0 60px}.drone-back{margin-bottom:43px}.drone-feature{margin-bottom:63px}.drone-photo-list{gap:30px}.drone-footer{padding:20px 0;align-items:flex-start;flex-direction:column;justify-content:center}}@media(max-width:390px){.drone-topbar nav{gap:10px}.drone-topbar nav a:first-child{display:none}.drone-topbar .wordmark{font-size:.82rem}.theme-toggle{width:32px;height:32px}}
</style>
