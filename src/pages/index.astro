---
import BaseLayout from '../layouts/BaseLayout.astro';
const links = [
  { label: 'Email', href: 'mailto:hello@joelmarte.com', icon: '↗' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/', icon: '↗' },
  { label: 'GitHub', href: 'https://github.com/', icon: '↗' },
];
---

<BaseLayout title="Joel Marte — Personal site" description="A little corner of the internet belonging to Joel Marte.">
  <div class="page-shell">
    <header class="topbar">
      <a class="wordmark" href="#top" aria-label="Joel Marte home"><span class="mark">jm</span><span>Joel Marte</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a class="nav-contact" href="mailto:hello@joelmarte.com">Say hello <span>↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow mono"><span class="dot"></span> Personal website <span class="slash">/</span> New York</p>
          <h1 id="hero-title">Hi, I’m<br /><em class="serif">Joel Marte.</em></h1>
          <p class="intro">A home for the things I’m making, thinking about, and figuring out along the way.</p>
          <a class="button" href="#about">A little about me <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-art" aria-label="Abstract green and blue shapes">
          <div class="art-grid"></div>
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div class="sun"></div><div class="leaf leaf-one"></div><div class="leaf leaf-two"></div>
          <span class="art-caption mono">A work in progress<br />Since day one</span>
          <span class="art-stamp mono">JM&nbsp;·&nbsp;NYC</span>
        </div>
        <div class="hero-index mono">01 <span>—</span> 03</div>
      </section>

      <section id="about" class="about section-row">
        <div class="section-label"><span class="number mono">01</span><span class="mono">A little about me</span></div>
        <div class="about-body">
          <p class="big-copy serif">Curious by nature.<br /><em>Always becoming.</em></p>
          <p class="body-copy">I’m Joel. This is my small corner of the internet—a place to share what I’m working on, what I’m learning, and what I care about. I believe the best things come from staying curious and making room for good ideas.</p>
          <a class="text-link" href="mailto:hello@joelmarte.com">Get in touch <span>↗</span></a>
        </div>
        <div class="about-note"><span class="note-line"></span><p class="mono">Currently open to<br />good conversations</p><span class="note-star">✳</span></div>
      </section>

      <section id="work" class="work section-row">
        <div class="section-label"><span class="number mono">02</span><span class="mono">A few things</span></div>
        <div class="work-body">
          <div class="work-heading"><h2 class="serif">What I’m <em>into.</em></h2><span class="mono">Updated occasionally</span></div>
          <div class="interest-list">
            <article class="interest"><span class="interest-icon">✳</span><div><h3>Making things</h3><p>Projects, experiments, and ideas that made it out of my notes app.</p></div><span class="interest-arrow">↗</span></article>
            <article class="interest"><span class="interest-icon">◌</span><div><h3>Learning out loud</h3><p>Things I’m exploring, useful rabbit holes, and new perspectives.</p></div><span class="interest-arrow">↗</span></article>
            <article class="interest"><span class="interest-icon">↗</span><div><h3>Finding good people</h3><p>Always glad to meet thoughtful people and hear what they’re building.</p></div><span class="interest-arrow">↗</span></article>
          </div>
          <p class="work-footnote mono">More to come. This page grows as I do.</p>
        </div>
      </section>

      <section class="contact">
        <div class="contact-orbit"><span></span></div>
        <div class="contact-copy"><p class="mono">03&nbsp; / &nbsp;Your turn</p><h2 class="serif">Have a good<br /><em>one in mind?</em></h2><a href="mailto:hello@joelmarte.com" class="contact-link">Let’s talk <span>↗</span></a></div>
        <div class="contact-aside mono">Ideas, introductions,<br />or just a hello.</div>
      </section>
    </main>

    <footer>
      <a class="wordmark" href="#top"><span class="mark">jm</span><span>Joel Marte</span></a>
      <p class="mono">Made with curiosity <span class="footer-star">✳</span></p>
      <div class="socials">{links.map((link) => <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noreferrer">{link.label} <span>{link.icon}</span></a>)}</div>
      <span class="copyright mono">© {new Date().getFullYear()} Joel Marte</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-shell{max-width:1440px;margin:auto;padding:0 7.2%}.topbar{height:88px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.wordmark{display:flex;gap:11px;align-items:center;text-decoration:none;font-weight:700;font-size:.9rem;letter-spacing:-.03em}.mark{display:grid;place-items:center;width:29px;height:29px;background:var(--acid);border-radius:50%;font-family:'Playfair Display',serif;font-size:.9rem;font-style:italic}.topbar nav{display:flex;align-items:center;gap:38px;font-size:.8rem}.topbar nav a{text-decoration:none}.topbar nav a:not(.nav-contact){color:#526057}.nav-contact{padding:11px 15px;border:1px solid var(--ink);border-radius:99px}.nav-contact span{margin-left:12px}
  .hero{position:relative;min-height:580px;padding:108px 0 104px;display:grid;grid-template-columns:1fr .88fr;align-items:center;gap:6%}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--muted)}.dot{width:7px;height:7px;background:#87a678;border-radius:50%;box-shadow:0 0 0 4px #e5ebdf}.slash{color:#bac0b4}.hero h1{font-size:clamp(4.4rem,8vw,7.5rem);line-height:.94;letter-spacing:-.07em;margin:34px 0 25px;font-weight:600}.hero h1 em{font-weight:500;letter-spacing:-.065em;color:#4e7057}.intro{max-width:390px;color:#68736a;font-size:1.02rem;line-height:1.75}.button{display:inline-flex;align-items:center;gap:28px;margin-top:25px;padding:14px 18px;background:var(--ink);color:#f5f4ee;text-decoration:none;border-radius:99px;font-size:.78rem}.button span{font-size:1rem;color:var(--acid)}.hero-art{height:370px;max-width:460px;width:100%;justify-self:end;position:relative;overflow:hidden;background:#dce8d6;border-radius:46% 46% 6px 6px / 34% 34% 6px 6px}.art-grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff48 1px,transparent 1px),linear-gradient(90deg,#ffffff48 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(130deg,black,transparent 82%)}.orbit{position:absolute;width:278px;height:278px;border:1px solid #81987b77;border-radius:50%;top:55px;left:82px}.orbit-two{width:360px;height:360px;top:13px;left:41px;border-color:#81987b44}.sun{position:absolute;width:162px;height:162px;border-radius:50%;background:var(--acid);top:79px;left:120px;box-shadow:0 15px 40px #63795b25}.leaf{position:absolute;background:#4b755e}.leaf-one{width:106px;height:157px;left:179px;top:91px;border-radius:100% 0 100% 0;transform:rotate(18deg)}.leaf-two{width:67px;height:117px;left:127px;top:151px;border-radius:0 100% 0 100%;transform:rotate(-19deg);background:#789476}.art-caption{position:absolute;bottom:31px;left:29px;line-height:1.8;color:#435b4b}.art-stamp{position:absolute;right:26px;top:25px;color:#576d55}.hero-index{position:absolute;bottom:30px;left:0;color:#707b70}.hero-index span{color:#b5bbae;margin:0 9px}
  .section-row{border-top:1px solid var(--line);display:grid;grid-template-columns:21% 1fr 18%;gap:4%;padding:68px 0}.section-label{display:flex;gap:15px;align-items:flex-start;color:#647066}.number{color:#8ea17c}.about-body{max-width:640px}.big-copy{font-size:clamp(2.2rem,4.3vw,3.8rem);line-height:1.18;letter-spacing:-.04em;margin:0 0 26px}.big-copy em,.work-heading em,.contact h2 em{color:#688069;font-weight:500}.body-copy{max-width:510px;color:#68736a;line-height:1.8;font-size:.94rem}.text-link{display:inline-block;margin-top:13px;padding-bottom:5px;text-decoration:none;border-bottom:1px solid #a6b09f;font-size:.83rem}.text-link span{margin-left:13px}.about-note{align-self:end;justify-self:end;max-width:150px;color:#768272;line-height:1.7}.note-line{display:block;width:31px;border-top:1px solid #92a08b;margin-bottom:15px}.note-star{font-size:1.7rem;color:#819775}
  .work{padding-bottom:82px}.work-body{grid-column:2/4}.work-heading{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px}.work-heading h2{font-weight:500;font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.04em;margin:0}.work-heading>span{color:#849080}.interest-list{border-top:1px solid var(--line)}.interest{min-height:91px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:42px 1fr 20px;align-items:center;gap:15px}.interest-icon{font-size:1.3rem;color:#7e9a77}.interest h3{font-size:.96rem;margin:0 0 5px;font-weight:600}.interest p{font-size:.79rem;color:#768076;margin:0}.interest-arrow{color:#87917f}.work-footnote{color:#87917f;margin-top:22px}
  .contact{position:relative;min-height:336px;background:var(--acid);padding:55px 8%;overflow:hidden;display:flex;align-items:center;justify-content:space-between}.contact-copy{position:relative;z-index:1}.contact-copy>p{margin:0 0 17px;color:#67764d}.contact h2{font-size:clamp(2.7rem,5.5vw,4.5rem);line-height:1.02;letter-spacing:-.05em;font-weight:500;margin:0 0 19px}.contact h2 em{color:#617353}.contact-link{display:inline-block;text-decoration:none;font-weight:600;border-bottom:1px solid #708052;padding-bottom:6px;font-size:.85rem}.contact-link span{margin-left:30px}.contact-aside{position:relative;z-index:1;align-self:end;color:#76864e;line-height:1.8}.contact-orbit{position:absolute;width:370px;height:370px;border:1px solid #6e824a50;border-radius:50%;right:17%;top:-5px;display:grid;place-items:center}.contact-orbit:before,.contact-orbit:after{content:'';position:absolute;border:1px solid #6e824a45;border-radius:50%;width:76%;height:76%}.contact-orbit:after{width:48%;height:48%}.contact-orbit span{width:76px;height:76px;border-radius:50%;background:#667c54}
  footer{min-height:112px;display:flex;align-items:center;justify-content:space-between;gap:22px}footer>p{color:#788175} .footer-star{color:#7f986f;font-size:1.2rem;margin-left:5px;vertical-align:-2px}.socials{display:flex;gap:21px}.socials a{text-decoration:none;font-size:.76rem;color:#626e63}.socials a span{margin-left:4px}.copyright{color:#929a8e}
  @media(max-width:760px){.page-shell{padding:0 6%}.topbar{height:72px}.topbar nav{gap:17px}.topbar nav a{font-size:.72rem}.nav-contact{padding:9px 11px}.nav-contact span{margin-left:5px}.hero{padding:69px 0 75px;grid-template-columns:1fr;gap:43px}.hero h1{font-size:clamp(4.3rem,16vw,6.5rem);margin-top:27px}.hero-art{justify-self:center;width:90%;height:310px}.sun{left:calc(50% - 81px)}.leaf-one{left:calc(50% - 25px)}.leaf-two{left:calc(50% - 77px)}.orbit{left:calc(50% - 139px)}.orbit-two{left:calc(50% - 180px)}.hero-index{bottom:22px}.section-row{grid-template-columns:1fr;gap:30px;padding:45px 0}.section-label{gap:12px}.about-body{padding-left:26px}.about-note{justify-self:start;margin-left:26px}.work-body{grid-column:auto;padding-left:0}.work-heading{align-items:flex-start;gap:18px;flex-direction:column}.interest{grid-template-columns:31px 1fr 15px;gap:11px;padding:14px 0}.interest p{line-height:1.55;max-width:310px}.contact{min-height:340px;padding:48px 7%}.contact-orbit{right:-102px;opacity:.6}.contact-aside{display:none}footer{padding:24px 0;display:grid;grid-template-columns:1fr auto;row-gap:17px}.socials{grid-column:1/-1;grid-row:2;gap:17px}.copyright{justify-self:end;grid-column:2;grid-row:1;font-size:.58rem}.footer>p{display:none}}
  @media(max-width:390px){.topbar nav{gap:12px}.topbar nav a:first-child{display:none}.topbar .wordmark{font-size:.82rem}.hero-art{height:275px}}
</style>
