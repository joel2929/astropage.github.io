---
const { title = 'Joel Marte — Personal site', description = 'The personal site of Joel Marte.' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color" name="theme-color" content="#080c14" />
    <meta name="description" content={description} />
    <script is:inline>
      try {
        if (localStorage.getItem('jm-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      const themeRoot = document.documentElement;
      const themeButton = document.querySelector('[data-theme-toggle]');
      const themeColor = document.querySelector('#theme-color');
      const syncTheme = (theme) => {
        themeRoot.dataset.theme = theme;
        themeButton?.setAttribute('aria-pressed', String(theme === 'light'));
        themeButton?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        themeButton?.setAttribute('title', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        const icon = themeButton?.querySelector('[data-theme-icon]');
        if (icon) icon.textContent = theme === 'dark' ? '☼' : '☾';
        if (themeColor) themeColor.content = theme === 'dark' ? '#080c14' : '#f4f7fc';
        try { localStorage.setItem('jm-theme', theme); } catch {}
      };
      syncTheme(themeRoot.dataset.theme === 'light' ? 'light' : 'dark');
      themeButton?.addEventListener('click', () => {
        syncTheme(themeRoot.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>

<style is:global>
  :root{font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--paper);color-scheme:dark;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#edf3ff;--muted:#98a8be;--line:#28364a;--acid:#4c8dff;--paper:#080c14;--nav-link:#c0cde0;--dot:#6fa4ff;--dot-shadow:#3d6fb655;--slash:#7284a1;--hero-title:#91baff;--button-text:#080c14;--hero-art:#101b2d;--art-grid:#ffffff24;--orbit:#7eacfa80;--orbit-faint:#5277ad55;--sun-shadow:#1b4a8a55;--leaf:#2f69bb;--leaf-secondary:#79aaff;--art-caption:#cad8ed;--art-stamp:#9cbbe8;--index:#9aaac1;--index-divider:#53637b;--section-label:#aab8cd;--number:#75a6f5;--accent:#7cacff;--body-copy:#b5c2d6;--link-border:#526d94;--note:#adbbce;--note-line:#6e86a9;--note-star:#80abf0;--work-meta:#a8b7cc;--interest-icon:#80aaf0;--interest-copy:#aebbd0;--interest-arrow:#91a2ba;--footnote:#91a2ba;--contact-kicker:#102b52;--contact-accent:#071a38;--contact-link:#102b52;--contact-note:#16345f;--contact-orbit:#102b5270;--contact-orbit-inner:#102b5262;--contact-core:#1e4e8a;--footer-copy:#aebbd0;--footer-star:#80abf0;--social:#bac9df;--copyright:#93a3bc;--focus:#4c8dff}
  html[data-theme="light"]{color-scheme:light;--ink:#111a29;--muted:#64738a;--line:#d6dfec;--acid:#2f70e8;--paper:#f4f7fc;--nav-link:#3b4b64;--dot:#3978e8;--dot-shadow:#dce8fb;--slash:#a5b1c2;--hero-title:#245db6;--button-text:#f7f9ff;--hero-art:#e3ebf7;--art-grid:#ffffff70;--orbit:#5f83ba77;--orbit-faint:#7692bc55;--sun-shadow:#3667ac35;--leaf:#3974c5;--leaf-secondary:#83a9e3;--art-caption:#344a69;--art-stamp:#526d94;--index:#687993;--index-divider:#a6b3c6;--section-label:#52627a;--number:#3978d5;--accent:#2e68c5;--body-copy:#53627a;--link-border:#a8b8d0;--note:#61718a;--note-line:#879ab7;--note-star:#3978d5;--work-meta:#718099;--interest-icon:#3978d5;--interest-copy:#687790;--interest-arrow:#718099;--footnote:#718099;--contact-kicker:#d8e5f8;--contact-accent:#f7f9ff;--contact-link:#e8f0fc;--contact-note:#e2ecfa;--contact-orbit:#173c7655;--contact-orbit-inner:#173c7645;--contact-core:#1a4e9c;--footer-copy:#697991;--footer-star:#3978d5;--social:#52627a;--copyright:#8794a6;--focus:#245db6}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:var(--paper);color:var(--ink);transition:background-color .25s ease,color .25s ease}a{color:inherit}::selection{background:var(--acid);color:var(--ink)}
  .mono{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;font-size:.68rem}
  .serif{font-family:'Playfair Display',Georgia,serif}
  :focus-visible{outline:3px solid var(--focus);outline-offset:4px}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
