---
const { title = 'Joel Marte — Personal site', description = 'The personal site of Joel Marte.' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color" name="theme-color" content="#101612" />
    <meta name="description" content={description} />
    <script is:inline>
      try {
        if (localStorage.getItem('jm-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      const themeRoot = document.documentElement;
      const themeButton = document.querySelector('[data-theme-toggle]');
      const themeColor = document.querySelector('#theme-color');
      const syncTheme = (theme) => {
        themeRoot.dataset.theme = theme;
        themeButton?.setAttribute('aria-pressed', String(theme === 'light'));
        themeButton?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        themeButton?.setAttribute('title', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        const icon = themeButton?.querySelector('[data-theme-icon]');
        if (icon) icon.textContent = theme === 'dark' ? '☼' : '☾';
        if (themeColor) themeColor.content = theme === 'dark' ? '#101612' : '#f5f4ee';
        try { localStorage.setItem('jm-theme', theme); } catch {}
      };
      syncTheme(themeRoot.dataset.theme === 'light' ? 'light' : 'dark');
      themeButton?.addEventListener('click', () => {
        syncTheme(themeRoot.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>

<style is:global>
  :root{font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--paper);color-scheme:dark;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#e9eee7;--muted:#a4aea3;--line:#3a463d;--acid:#d8f17a;--paper:#101612;--nav-link:#bdc8bb;--dot:#a5c493;--dot-shadow:#82977955;--slash:#8b998c;--hero-title:#a5c79c;--button-text:#172017;--hero-art:#1e2d23;--art-grid:#ffffff24;--orbit:#a3bc9a80;--orbit-faint:#a3bc9a52;--sun-shadow:#63795b55;--leaf:#5e8b6d;--leaf-secondary:#91ad84;--art-caption:#d2dfd0;--art-stamp:#b8cdb7;--index:#a5b0a4;--index-divider:#6e7c6e;--section-label:#aab7aa;--number:#a7c18e;--accent:#a9c89f;--body-copy:#b5c0b4;--link-border:#687b68;--note:#aebbad;--note-line:#8da189;--note-star:#a2c08e;--work-meta:#aab7a7;--interest-icon:#9dbf8f;--interest-copy:#b0bcae;--interest-arrow:#9eaa9a;--footnote:#9ca996;--contact-kicker:#495c39;--contact-accent:#465936;--contact-link:#4c5b3d;--contact-note:#506440;--contact-orbit:#6e824a70;--contact-orbit-inner:#6e824a62;--contact-core:#667c54;--footer-copy:#b0bbae;--footer-star:#a7c48e;--social:#bac5b8;--copyright:#939f92;--focus:#a7c87e}
  html[data-theme="light"]{color-scheme:light;--ink:#182822;--muted:#717a70;--line:#d9ddd0;--acid:#e7ff63;--paper:#f5f4ee;--nav-link:#526057;--dot:#87a678;--dot-shadow:#e5ebdf;--slash:#bac0b4;--hero-title:#4e7057;--button-text:#f5f4ee;--hero-art:#dce8d6;--art-grid:#ffffff48;--orbit:#81987b77;--orbit-faint:#81987b44;--sun-shadow:#63795b25;--leaf:#4b755e;--leaf-secondary:#789476;--art-caption:#435b4b;--art-stamp:#576d55;--index:#707b70;--index-divider:#b5bbae;--section-label:#647066;--number:#8ea17c;--accent:#688069;--body-copy:#68736a;--link-border:#a6b09f;--note:#768272;--note-line:#92a08b;--note-star:#819775;--work-meta:#849080;--interest-icon:#7e9a77;--interest-copy:#768076;--interest-arrow:#87917f;--footnote:#87917f;--contact-kicker:#67764d;--contact-accent:#617353;--contact-link:#708052;--contact-note:#76864e;--contact-orbit:#6e824a50;--contact-orbit-inner:#6e824a45;--contact-core:#667c54;--footer-copy:#788175;--footer-star:#7f986f;--social:#626e63;--copyright:#929a8e;--focus:#5b7044}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:var(--paper);color:var(--ink);transition:background-color .25s ease,color .25s ease}a{color:inherit}::selection{background:var(--acid);color:var(--ink)}
  .mono{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;font-size:.68rem}
  .serif{font-family:'Playfair Display',Georgia,serif}
  :focus-visible{outline:3px solid var(--focus);outline-offset:4px}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
